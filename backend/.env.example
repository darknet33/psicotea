# Base de datos
DATABASE_URL="mysql://user:password@localhost:3306/psicotea_db"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRATION="7d"

# NestJS
PORT=3001
# Host donde escucha el backend. "0.0.0.0" lo expone a la red (accesible por IP).
HOST=0.0.0.0
# development | production
NODE_ENV=development

# Frontend URLs (for CORS). Separa varias con coma: "http://localhost:3000,http://192.168.1.10:3000"
FRONTEND_URL="http://localhost:3000"