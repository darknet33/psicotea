# Base de datos
DATABASE_URL="mysql://user:password@localhost:3306/psicotea_db"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRATION="7d"

# Firma de los tokens de credencial de niños (QR).
# 32 bytes aleatorios en hex (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Separate de JWT_SECRET para poder rotarlos por separado.
CREDENTIAL_SECRET="your-credential-secret-here"

# NestJS
PORT=3001
# Host donde escucha el backend. "0.0.0.0" lo expone a la red (accesible por IP).
HOST=0.0.0.0
# development | production
NODE_ENV=development

# Frontend URLs (for CORS). Separa varias con coma: "http://localhost:3000,http://192.168.1.10:3000"
FRONTEND_URL="http://localhost:3000"

# Directorio donde se guardan las imágenes subidas (fotos de niños).
# Relativa al cwd del backend. Se sirve estáticamente en /uploads/*
UPLOAD_DIR="uploads"