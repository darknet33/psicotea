# Base de datos
DATABASE_URL="mysql://user:secure_password@prod-host:3306/psicotea_db"

# JWT (valores seguros generados aleatoriamente)
JWT_SECRET="<generar-aleatorio>"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="<generar-aleatorio>"
JWT_REFRESH_EXPIRATION="7d"

# Firma de los tokens de credencial de niños (QR)
CREDENTIAL_SECRET="<generar-aleatorio>"

# NestJS
PORT=3001
NODE_ENV=production

# Frontend URLs (for CORS)
FRONTEND_URL="https://psicotea.com"

# Directorio donde se guardan las imágenes subidas (fotos de niños).
UPLOAD_DIR="uploads"