generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Creates the database if it doesn't exist
}

enum Role {
  ADMIN
  ESPECIALISTA
  PERSONAL_ADMINISTRATIVO
}

enum EnrollmentStatus {
  ACTIVO
  INACTIVO
  RETIRADO
}

enum EnrollmentType {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum PaymentMethod {
  EFECTIVO
  QR
  TRANSFERENCIA
}

enum Shift {
  TODO_DIA
  MANANA
  TARDE
}

enum SpecialistShift {
  MANANA
  TARDE
  AMBOS
}

enum AreaKind {
  PRINCIPAL
  SECUNDARIA
}

enum PlanFrequency {
  DAILY
  WEEKLY
}

enum ReportType {
  EVALUACION
  EVOLUTIVO
  PERIODICO
}

enum ReportPeriod {
  INICIO
  MEDIADOS
  FIN
  NINGUNO
}

model User {
  id                Int            @id @default(autoincrement())
  email             String         @unique
  password          String
  name              String
  lastName          String
  role              Role           @default(PERSONAL_ADMINISTRATIVO)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  specialist        Specialist?
  staff             Staff?
  refreshTokens     RefreshToken[]
  attendanceRecords Attendance[]   @relation("AttendanceRegisteredBy")
  activityRecords   Activity[]     @relation("ActivitySpecialist")
  reportRecords     Report[]       @relation("ReportSpecialist")
  expensesCreated   Expense[]
  specialistPaymentsCreated SpecialistPayment[] @relation("SpecialistPaymentCreatedBy")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(512)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Child {
  id             Int          @id @default(autoincrement())
  name           String
  lastName       String
  dateOfBirth    DateTime
  sex            String
  photoUrl       String
  diagnostico    String
  carnet         String       @unique
  credentialCode String       @unique
  isActive       Boolean      @default(true)
  enrollments    Enrollment[]
  attendances    Attendance[]
  activities     Activity[]
  reports        Report[]
  payments       Payment[]
  tutors         ChildTutor[]
  treatmentPlans TreatmentPlan[]
  evolutionNotes EvolutionNote[]
  specialistId   Int?
  specialist     Specialist?  @relation(fields: [specialistId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([specialistId])
  @@index([isActive])
}

model Tutor {
  id        Int          @id @default(autoincrement())
  name      String
  lastName  String
  phone     String
  email     String?
  address   String?
  carnet    String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  children  ChildTutor[]
}

model ChildTutor {
  childId      Int
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  tutorId      Int
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  relationship String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([childId, tutorId])
  @@index([childId])
  @@index([tutorId])
}

model Enrollment {
  id           Int                     @id @default(autoincrement())
  childId      Int
  child        Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  type         EnrollmentType?
  startDate    DateTime
  endDate      DateTime?
  durationDays Int?
  status       EnrollmentStatus        @default(ACTIVO)
  amount       Decimal                 @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  payments     Payment[]
  allocations  PaymentAllocation[]
  areas        EnrollmentArea[]
  scheduleDays EnrollmentScheduleDay[]

  @@index([childId])
  @@index([status])
}

model EnrollmentScheduleDay {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  shift        Shift
  createdAt    DateTime   @default(now())

  @@unique([enrollmentId, dayOfWeek])
  @@index([dayOfWeek])
}

model Area {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  kind        AreaKind         @default(SECUNDARIA)
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  enrollments EnrollmentArea[]
  specialists SpecialistArea[]
  treatmentPlans TreatmentPlan[]
}

model EnrollmentArea {
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  areaId       Int
  area         Area       @relation(fields: [areaId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([enrollmentId, areaId])
  @@index([areaId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  childId      Int
  child        Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  enrollmentId Int?
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  paymentDate  DateTime
  method       PaymentMethod
  reference    String?
  description  String?
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  allocations  PaymentAllocation[]

  @@index([childId])
  @@index([paymentDate])
  @@index([enrollmentId])
}

model PaymentAllocation {
  id           Int        @id @default(autoincrement())
  paymentId    Int
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())

  @@unique([paymentId, enrollmentId])
  @@index([enrollmentId])
}

model Attendance {
  id             Int              @id @default(autoincrement())
  childId        Int
  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  status         AttendanceStatus
  notes          String?
  registeredById Int
  registeredBy   User             @relation("AttendanceRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([childId, date])
  @@index([childId])
  @@index([date])
  @@index([registeredById])
}

model Activity {
  id           Int      @id @default(autoincrement())
  childId      Int
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId Int
  specialist   User     @relation("ActivitySpecialist", fields: [specialistId], references: [id])
  date         DateTime @db.Date
  title        String
  description  String?
  duration     Int? // minutes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([childId])
  @@index([specialistId])
  @@index([date])
}

model Report {
  id           Int      @id @default(autoincrement())
  childId      Int
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId Int
  specialist   User     @relation("ReportSpecialist", fields: [specialistId], references: [id])
  title        String
  content      String   @db.Text
  type         ReportType   @default(EVOLUTIVO)
  reportPeriod ReportPeriod @default(NINGUNO)
  summary      String?  @db.Text
  periodStart  DateTime
  periodEnd    DateTime
  isDraft      Boolean  @default(true)
  visibilityToParents Boolean @default(false)
  pdfUrl       String?
  attachments  ReportAttachment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([childId])
  @@index([specialistId])
  @@index([createdAt])
}

model Specialist {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId String   @unique
  specialty      String
  licenseNumber  String?
  phone          String?
  address        String?
  entryDate      DateTime @default(now())
  monthlySalary  Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  children       Child[]
  schedules      SpecialistSchedule[]
  areas          SpecialistArea[]
  payments       SpecialistPayment[]
  treatmentPlans TreatmentPlan[]
  evolutionNotes EvolutionNote[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Staff {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String   @unique
  position   String
  department String?
  hireDate   DateTime
  salary     Decimal? @db.Decimal(10, 2)
  phone      String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @db.Date
  description String?
  receiptUrl  String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([date])
  @@index([createdById])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String? // hex color for UI
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SpecialistSchedule {
  id           Int              @id @default(autoincrement())
  specialistId Int
  specialist   Specialist       @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  shift        SpecialistShift?
  startTime    String?          @db.VarChar(5)
  endTime      String?          @db.VarChar(5)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([specialistId, dayOfWeek])
  @@index([dayOfWeek])
}

model SpecialistArea {
  specialistId Int
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  areaId       Int
  area         Area       @relation(fields: [areaId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([specialistId, areaId])
  @@index([areaId])
}

model SpecialistPayment {
  id           Int        @id @default(autoincrement())
  specialistId Int
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(10, 2)
  periodStart  DateTime   @db.Date
  periodEnd    DateTime   @db.Date
  paymentDate  DateTime   @db.Date
  method       PaymentMethod
  notes        String?
  createdById  Int
  createdBy    User       @relation("SpecialistPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([specialistId])
  @@index([paymentDate])
}

model TreatmentPlan {
  id           Int                @id @default(autoincrement())
  childId      Int
  child        Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId Int
  specialist   Specialist         @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  areaId       Int?
  area         Area?              @relation(fields: [areaId], references: [id])
  frequency    PlanFrequency      @default(WEEKLY)
  startDate    DateTime           @db.Date
  endDate      DateTime?          @db.Date
  notes        String?
  isActive     Boolean            @default(true)
  items        TreatmentPlanItem[]
  evolutionNotes EvolutionNote[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([childId])
  @@index([specialistId])
}

model TreatmentPlanItem {
  id           Int             @id @default(autoincrement())
  planId       Int
  plan         TreatmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dayOfWeek    Int?
  order        Int             @default(0)
  evolutionNotes EvolutionNote[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([planId])
}

model EvolutionNote {
  id           Int              @id @default(autoincrement())
  childId      Int
  child        Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  specialistId Int
  specialist   Specialist       @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  planId       Int?
  plan         TreatmentPlan?   @relation(fields: [planId], references: [id])
  planItemId   Int?
  planItem     TreatmentPlanItem? @relation(fields: [planItemId], references: [id])
  date         DateTime         @db.Date
  content      String           @db.Text
  observation  String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([childId])
  @@index([specialistId])
  @@index([date])
}

model ReportAttachment {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([reportId])
}
